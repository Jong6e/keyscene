{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keyscene",
  "version": "0.3.1",
  "identifier": "Keyscene",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: http://icon.localhost; connect-src ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Keyscene",
    "shortDescription": "단축키 하나로 Windows 동작 여러 개를 실행하고 되돌리는 트레이 도구",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean"
        ],
        "installerIcon": "icons/icon.ico"
      }
    },
    "copyright": "Copyright (c) 2026 Jong6e. MIT License."
  }
}
